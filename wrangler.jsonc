{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asiana",
  "compatibility_date": "2026-08-03",
  "preview_urls": true,
  "no_bundle": true,
  "env": {
    "production": {
      "route": "asiana",
      "workers_dev": true,
    },
    "preview": {
      "route": "preview-asiana",
      "workers_dev": true,
    }
  }
}
